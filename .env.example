# --- LLM provider (the V0 coach; DeepSeek is the default) ---
DEEPSEEK_API_KEY=sk-...
# Optional fallback while the provider migration finishes:
ANTHROPIC_API_KEY=sk-ant-...
# Targeted DeepSeek OpenAI-compatible structured-output path (off unless stabilizing the contract):
FITMAS_USE_DEEPSEEK_OPENAI_STRUCTURED=0

# --- V0 Telegram coach (scripts/dogfood_telegram.py) ---
FITMAS_V0_BOT_TOKEN=                # a Telegram bot token (or TELEGRAM_BOT_TOKEN)
FITMAS_V0_DOGFOOD_CHAT_IDS=         # comma-separated allowlist of Telegram chat ids (via @userinfobot)
FITMAS_V0_DOGFOOD_PROVIDER=deepseek
FITMAS_V0_DB_PATH=fitmas_v0.db      # the V0 store (source of truth for the coach)

# --- Strava -> V0 sync (optional; the bot pulls recent runs into the V0 store) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
FITMAS_V0_STRAVA_LEGACY_USER=1      # legacy user id holding the Strava token (solo)
FITMAS_V0_STRAVA_SYNC_SECONDS=900   # sync interval
FITMAS_V0_STRAVA_CALORIES_PER_SYNC=25  # cap on per-activity detailed calories fetches per run

# --- Webapp (legacy FastAPI/React; reads the V0 store when FITMAS_APP_SOURCE=v0) ---
FITMAS_APP_SOURCE=v0
FITMAS_DB_PATH=fitmas.db            # legacy DB (Strava token, webapp lifespan seed)
# FITMAS_APP_PASSWORD=              # set to gate the whole webapp behind HTTP Basic auth
