#!/usr/bin/env zsh

set -euo pipefail

PORT="${PORT:-8033}"
HOST="${HOST:-0.0.0.0}"
LOCAL_HOST="${LOCAL_HOST:-127.0.0.1}"

# Show local IP for phone access
LOCAL_IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "unknown")

if lsof -nP -iTCP:${PORT} -sTCP:LISTEN >/dev/null 2>&1; then
  echo "✗ Refusing to start FitMAS on port ${PORT}: already in use."
  echo ""
  lsof -nP -iTCP:${PORT} -sTCP:LISTEN || true
  echo ""
  echo "Why this stops here:"
  echo "- another app may already own 127.0.0.1:${PORT}"
  echo "- FitMAS could still bind 0.0.0.0:${PORT} and split localhost vs network traffic"
  echo "- that makes it easy to think you are testing FitMAS when you are hitting another app"
  echo ""
  echo "Next:"
  echo "- stop the existing listener"
  echo "- or run PORT=8040 ./scripts/dev"
  exit 1
fi

echo "→ FitMAS local:   http://${LOCAL_HOST}:${PORT}"
if [ "${LOCAL_IP}" != "unknown" ]; then
  echo "→ FitMAS réseau:  http://${LOCAL_IP}:${PORT}"
else
  echo "→ FitMAS réseau:  unavailable (no local IP found)"
fi
echo "→ Health:         http://${LOCAL_HOST}:${PORT}/health"
echo ""

exec ./.venv/bin/python -m uvicorn --app-dir backend/src fitmas.main:app --reload --host "${HOST}" --port "${PORT}"
