#!/bin/sh
set -e

echo "Starting FitMAS production..."

# Start the V0 dogfood coach on Telegram in background (replaces the legacy bot).
# It polls TELEGRAM_BOT_TOKEN, routes the allowlisted user to runtime_v0.handle_event
# on its own v0_* store (FITMAS_V0_DB_PATH). A crash here never kills the API below.
if [ -n "$TELEGRAM_BOT_TOKEN" ]; then
    echo "Starting V0 coach (Telegram)..."
    python scripts/dogfood_telegram.py &
fi

# Start API server
echo "Starting API on port 8000..."
exec python -m uvicorn --app-dir backend/src fitmas.main:app --host 0.0.0.0 --port 8000
