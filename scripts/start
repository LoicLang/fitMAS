#!/bin/sh
# Starts API + Telegram bot in production

set -e

# Start bot in background if token is set
if [ -n "$TELEGRAM_BOT_TOKEN" ]; then
  echo "→ Starting Telegram bot..."
  python -m fitmas.telegram_bot &
fi

# Start API (foreground)
echo "→ Starting API on port 8000..."
python -m uvicorn --app-dir backend/src fitmas.main:app \
  --host 0.0.0.0 \
  --port 8000 \
  --workers 1
